EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-beautybooking

EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
EXPO_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/demo-beautybooking/us-central1/api

# Only needed when EXPO_PUBLIC_USE_EMULATORS=false (real Firebase project).
# Get these from Firebase Console -> Project settings -> General -> Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=