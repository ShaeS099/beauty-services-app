rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload their own profile images
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Providers' portfolio media (images + video). Path/naming matches the `providers`
    // Firestore collection. Real writes go through the client SDK directly to Storage;
    // this rule is the actual enforcement point (unlike Firestore, there's no Admin-SDK
    // intermediary here).
    match /providers/{providerId}/posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == providerId
        && request.resource.size < 100 * 1024 * 1024 // 100MB placeholder; no transcoding/CDN pipeline yet
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
    
    // Identity verification documents — PRIVATE, unlike portfolio posts. Only the provider
    // themself can read/write their own upload; there is no admin review UI yet, so approval
    // happens by directly editing the Firestore provider document.
    match /providers/{providerId}/verification/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == providerId;
      allow write: if request.auth != null && request.auth.uid == providerId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // General media uploads (with size and type restrictions)
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 && // 10MB max
        request.resource.contentType.matches('image/.*');
    }
  }
} 